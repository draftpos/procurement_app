<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_create_supplier_quote_form" model="ir.ui.view">
        <field name="name">wizard.create.supplier.quote.form</field>
        <field name="model">wizard.create.supplier.quote</field>
        <field name="arch" type="xml">
            <form string="Create Supplier Quote">
                <group>
                    <field name="rfq_id" invisible="1"/>
                    <field name="available_supplier_ids" invisible="1"/>
                    <field name="supplier_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_create_quote" string="Create Quote" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_create_supplier_quote" model="ir.actions.act_window">
        <field name="name">Create Supplier Quote</field>
        <field name="res_model">wizard.create.supplier.quote</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_rfq_tree" model="ir.ui.view">
        <field name="name">custom.rfq.tree</field>
        <field name="model">custom.rfq</field>
        <field name="arch" type="xml">
            <list string="RFQ">
                <field name="name"/>
                
                <field name="transaction_date"/>
                <field name="order_deadline"/>
                <field name="amount_untaxed"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_rfq_form" model="ir.ui.view">
        <field name="name">custom.rfq.form</field>
        <field name="model">custom.rfq</field>
        <field name="arch" type="xml">
            <form string="RFQ">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'rfq'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight btn-success" invisible="state != 'pending_approval'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending_approval'"/>
                    <button name="action_confirm" string="Confirm RFQ" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="all_quotes_created" invisible="1"/>
                    <button name="%(material_requisition.action_wizard_create_supplier_quote)d" string="Create Supplier Quote" type="action" class="oe_highlight" invisible="state != 'rfq_sent' or all_quotes_created"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('rfq_sent', 'done', 'cancel', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="rfq,pending_approval,approved,rfq_sent,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_date"/>
                            <field name="requested_by_id" readonly="1" widget="badge" decoration-warning="1"/>
                            <field name="request_to_ids" widget="many2many_tags" options="{'color_field': 'color'}" domain="[('group_ids', 'in', %(material_requisition.group_rfq_approver)d)]" required="1"/>
                        </group>
                        <group>
                            <field name="order_deadline" decoration-success="1"/>
                            <field name="approved_by_id" readonly="1" widget="badge" decoration-info="1"/>
                            <field name="requisition_id"/>
                        </group>
                    </group>
                    <separator string="Suppliers"/>
                    <field name="supplier_ids" mode="list">
                        <list editable="bottom">
                            <field name="partner_id" string="Supplier"/>
                            <field name="email" string="Email"/>
                            <field name="phone" string="Phone"/>
                            <field name="send_email" widget="boolean_toggle" string="Send Email"/>
                            <field name="quote_status" widget="badge"
                                decoration-warning="quote_status == 'pending'"
                                decoration-success="quote_status == 'received'"
                                decoration-danger="quote_status == 'rejected'"
                                string="Quote Status"/>
                            <field name="email_sent" widget="boolean_toggle" string="Email Sent"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="taxes_id" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="notes" nolabel="1" placeholder="Define your terms and conditions ..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed" string="Total Excl. Amount" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <field name="amount_tax" string="Taxes" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <div class="oe_subtotal_footer_separator oe_inline">
                                        <label for="amount_total" string="Total Inclusive" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_custom_rfq" model="ir.actions.act_window">
        <field name="name">RFQ</field>
        <field name="res_model">custom.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new RFQ
            </p>
        </field>
    </record>

    

    

    

    <record id="view_custom_rfq_search" model="ir.ui.view">
        <field name="name">custom.rfq.search</field>
        <field name="model">custom.rfq</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Reference"/>
                
                <field name="requested_by_id" string="Requested By"/>
                <field name="approved_by_id" string="Approved By"/>
                <field name="transaction_date" string="Transaction Date"/>
                <field name="order_deadline" string="Order Deadline"/>
                <field name="state" string="Status"/>
                
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="state_approved" domain="[('state', '=', 'approved')]"/>
                
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    
                    <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by_id'}"/>
                    <filter string="Approved By" name="group_approved_by" context="{'group_by': 'approved_by_id'}"/>
                    <filter string="Transaction Date" name="group_transaction_date" context="{'group_by': 'transaction_date'}"/>
                    <filter string="Order Deadline" name="group_order_deadline" context="{'group_by': 'order_deadline'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_purchase_invoice_tree" model="ir.ui.view">
        <field name="name">custom.purchase.invoice.tree</field>
        <field name="model">custom.purchase.invoice</field>
        <field name="arch" type="xml">
            <list string="Purchase Invoice">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="transaction_date"/>
                <field name="order_deadline"/>
                <field name="amount_untaxed"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_purchase_invoice_form" model="ir.ui.view">
        <field name="name">custom.purchase.invoice.form</field>
        <field name="model">custom.purchase.invoice</field>
        <field name="arch" type="xml">
            <form string="Purchase Invoice">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight btn-success" invisible="state != 'pending_approval'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'pending_approval'"/>
                    <button name="action_confirm" string="Confirm Purchase Invoice" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_create_grv" string="Create GRV" type="object" class="oe_highlight" invisible="state != 'invoice'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('invoice', 'cancel', 'rejected', 'pending_approval')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,invoice"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="purpose"/>
                            <field name="requested_by_id" readonly="1" widget="badge" decoration-warning="1"/>
                            <field name="request_to_ids" widget="many2many_tags" options="{'color_field': 'color'}" domain="[('group_ids', 'in', %(material_requisition.group_custom_purchase_invoice_approver)d)]" required="1"/>
                        </group>
                        <group>
                            <field name="order_deadline" decoration-success="1"/>
                            <field name="transaction_date"/>
                            <field name="approved_by_id" readonly="1" widget="badge" decoration-info="1"/>
                            <field name="purchase_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="taxes_id" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="notes" nolabel="1" placeholder="Define your terms and conditions ..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed" string="Total Excl. Amount" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <field name="amount_tax" string="Taxes" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.2em; color: black;"/>
                                    <div class="oe_subtotal_footer_separator oe_inline">
                                        <label for="amount_total" string="Total Inclusive" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 900; font-size: 1.5em; color: black;"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_custom_purchase_invoice" model="ir.actions.act_window">
        <field name="name">Purchase Invoice</field>
        <field name="res_model">custom.purchase.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Purchase Invoice
            </p>
        </field>
    </record>
</odoo>
